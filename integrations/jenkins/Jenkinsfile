pipeline {
    agent any

    environment {
        ZT_CONFIG_DIR = "${WORKSPACE}\\configs"
        PYTHONUNBUFFERED = "1"
        PYTHON = "C:\\Users\\nares\\AppData\\Local\\Programs\\Python\\Python313\\python.exe"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================================='
                echo 'CHECKING OUT SOURCE CODE'
                echo '========================================================='

                checkout scm
            }
        }

        stage('Zero-Trust Security Validation Gate') {
            steps {
                echo '========================================================='
                echo 'ZERO-TRUST SECURITY VALIDATION GATE'
                echo '========================================================='

                echo 'Verifying commit signature...'
                echo 'Verifying dependency integrity...'
                echo 'Verifying runner integrity...'
                echo 'Applying security policy...'

                bat '''
                    "%PYTHON%" -m pip install -q -r backend\\requirements.txt
                    "%PYTHON%" -m validator.cli validate --path "%WORKSPACE%"
                '''

                echo '========================================================='
                echo 'ZERO-TRUST VALIDATION PASSED'
                echo 'BUILD AUTHORIZED'
                echo '========================================================='
            }
        }

        stage('Build') {
            steps {
                echo '========================================================='
                echo 'BUILD STAGE'
                echo 'AUTHORIZED BY ZERO-TRUST POLICY'
                echo '========================================================='

                bat '''
                    echo Building in cryptographically verified environment...
                '''
            }
        }

        stage('Test') {
            steps {
                echo '========================================================='
                echo 'TEST STAGE'
                echo '========================================================='

                bat '''
                    echo Executing automated test suite...
                    "%PYTHON%" -m pytest backend\\tests
                '''
            }
        }
    }

    post {
        success {
            echo '========================================================='
            echo 'PIPELINE SUCCESS'
            echo 'ZERO-TRUST VERIFICATION PASSED'
            echo 'BUILD AND TEST COMPLETED'
            echo '========================================================='
        }

        failure {
            echo '========================================================='
            echo 'PIPELINE BLOCKED / FAILED'
            echo 'ZERO-TRUST SECURITY GATE FAILED'
            echo 'UNTRUSTED OR TAMPERED ENVIRONMENT WAS NOT ALLOWED'
            echo '========================================================='
        }
    }
}